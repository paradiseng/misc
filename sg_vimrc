function! TermActive()
    let bufferNum = bufnr('ToggleTerminal')
    if bufferNum != -1 && bufloaded(bufferNum) == 1
        if bufwinnr(bufferNum) != -1
            return 1
        endif
    endif
    return 0
endfunction

function! ToggleListCmd()
    if TermActive()
        exec "ToggleTerminal"
    endif

    exe "botright copen"
endfunction

function! IsQuickfixOpen() abort
    let wins = filter(getwininfo(), 'v:val.quickfix && ! v:val.loclist')
    return !empty(wins)
endfunction

function! IsQuickfixOpenInCurrentTab() abort
    let wins = filter(getwininfo(), 'v:val.quickfix && !v:val.loclist && v:val.tabnr == tabpagenr()')
    return !empty(wins)
endfunction

function! HideQuickfixToggleTerm()
    if IsQuickfixOpenInCurrentTab()
        exec "cclose"
    endif
    exec "ToggleTerminal"
endfunction

function! CloseTermIfActive()
    if TermActive()
        exec "ToggleTerminal"
    endif
endfunction

