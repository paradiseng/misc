function! CloseAndReturn()
    " Save the ID we want to return to from the buffer variable
    let l:target_win = get(b:, 'ret_win', 0)

    " Close both possible list types
    lclose
    cclose

    " If we have a saved ID, force vim to go there
    if l:target_win != 0
        call win_gotoid(l:target_win)
    endif
endfunction

