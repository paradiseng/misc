function! SyncLocationListSilent()
    " 1. Find the window ID of the open Location List
    let l:loc_info = filter(getwininfo(), 'v:val.loclist')
    if empty(l:loc_info) | return | endif
    let l:loc_winid = l:loc_info[0].winid

    " 2. Find the match for the current line
    let l:curr_line = line('.')
    let l:loc_list = getloclist(0)
    let l:index = 1

    for item in l:loc_list
        if item.lnum == l:curr_line
            " 3. use win_execute to move the 'active' line in that window
            " 'normal! m'' saves the position, and 'normal! G' moves it.
            " we use 'zz' to keep the highlighted error centered in the bottom pane.
            call win_execute(l:loc_winid, 'exe ' . l:index . ' | normal! zz')
            return
        endif
        let l:index += 1
    endfor
endfunction

