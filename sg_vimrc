function! ToggleSmartLspErrors()
    " 1. Check if ANY location list is already open
    let l:loc_winid = filter(getwininfo(), 'v:val.loclist')
    if !empty(l:loc_winid)
        " Close it from anywhere
        windo lclose
        
        " wincmd p
        if exists('g:last_code_win')
            call win_gotoid(g:last_code_win)
        endif
        return
    endif
    
    " 2. We are opening: Clear stale data and get fresh diagnostics
    call setloclist(0, [], 'r')
    LspDocumentDiagnostics
    
    " 3. Get the current window ID before trying to open the list
    let l:curr_win = win_getid()
    
    " 4. Attempt to open the window if errors exist
    lwindow
    
    " 5. ONLY move the window if lwindow actually opened a new window
    if win_getid() != l:curr_win
        " We are now inside the location list window, move it to the bottom
        wincmd J
        " Optional: Jump back to the code window so you can keep typing
        call win_gotoid(l:curr_win)
    endif
endfunction

